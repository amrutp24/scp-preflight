{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyPlatformTeamTouchesIam",
      "Effect": "Deny",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:AttachRolePolicy",
        "iam:PutRolePolicy"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:PrincipalTag/team": "platform"
        }
      }
    }
  ]
}
